# ── Engine ────────────────────────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://kago:kago@localhost:5432/kagoroute
REDIS_URL=redis://localhost:6379
RUST_LOG=info,tower_http=debug
# Optional: path to a menu-schema file (.json or YAML). Unset → embedded demo flow.
#FLOW_SCHEMA_PATH=docs/examples/farmer-order.yaml

# ── Engine security ───────────────────────────────────────────────────────
# Shared secret(s) required on POST /ussd/callback via the X-KagoRoute-Key header.
# Use USSD_CALLBACK_SECRET for a single tenant, or USSD_CALLBACK_SECRETS as a
# comma-separated list (one key per tenant). Unset → endpoint is UNAUTHENTICATED
# (local dev only; the engine warns at boot).
USSD_CALLBACK_SECRET=
#USSD_CALLBACK_SECRETS=tenant-a-key,tenant-b-key
# Comma-separated browser origins allowed by CORS (e.g. the dashboard).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Maximum accepted callback body size in bytes.
USSD_MAX_BODY_BYTES=4096

# ── Dashboard ─────────────────────────────────────────────────────────────
# Base URL of the engine, used by the dashboard for API calls / health checks
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080
