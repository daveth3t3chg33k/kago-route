# ── KagoRoute · engine ───────────────────────────────────────────────────
# Copy to .env to override defaults. The engine reads this file at boot
# (dotenv) — see engine/crates/engine/src/config.rs for all options.

# HTTP port for the engine's API (default 8080).
PORT=8080

# Postgres connection string (default localhost:5432/kagoroute).
DATABASE_URL=postgres://kago:kago@localhost:5432/kagoroute

# Redis URL for the session store (default localhost:6379).
REDIS_URL=redis://localhost:6379

# Path to a menu-schema file (.json or .yaml). Unset = embedded demo flow.
FLOW_SCHEMA_PATH=

# ── Security (required before pointing at a real carrier) ────────────────
# Shared secret(s) required on POST /ussd/callback via the X-KagoRoute-Key
# header. One per tenant; comma-separate for multiple. Empty = unauthenticated.
USSD_CALLBACK_SECRET=
USSD_CALLBACK_SECRETS=

# Browser origins allowed by CORS (the dashboard), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum accepted request body size for /ussd/callback, in bytes.
USSD_MAX_BODY_BYTES=4096

# ── KagoRoute · dashboard ────────────────────────────────────────────────
# Next.js dashboard config. NEXT_PUBLIC_* vars are inlined at BUILD time —
# for local dev copy dashboard/.env.local.example → dashboard/.env.local.

# Base URL of the engine the dashboard polls.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080
